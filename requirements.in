# Direct dependencies, with the lowest versions we support.
#
# Don't install from this file. Install from requirements.txt, the lock file
# compiled from it with every package (including transitive ones) pinned:
#
#   pip install -r requirements.txt
#
# After changing this file, or to upgrade, regenerate the lock file with uv
# (https://docs.astral.sh/uv/) and commit both files:
#
#   uv pip compile requirements.in --universal --python-version 3.10 \
#       -o requirements.txt            # add --upgrade to take new versions
#
# --universal makes one lock file valid on both macOS and the Pi.

